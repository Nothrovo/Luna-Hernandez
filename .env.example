# Copy file ini ke .env lalu isi nilainya
# cp .env.example .env

# Wajib diganti: minimal 32 karakter acak
# Generate dengan: openssl rand -hex 32
N8N_ENCRYPTION_KEY=GANTI_DENGAN_STRING_ACAK_MINIMAL_32_KARAKTER

# Google Gemini API Key (untuk sintesis berita & AI research)
# Dapatkan dari: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Alpaca Basic gratis (market data saham AS via IEX)
# Buat paper account/API key di Alpaca, lalu isi dua nilai berikut.
ALPACA_API_KEY_ID=YOUR_ALPACA_KEY_ID_HERE
ALPACA_API_SECRET=YOUR_ALPACA_SECRET_HERE

# SEC meminta User-Agent yang dapat mengidentifikasi aplikasi/kontak.
SEC_USER_AGENT=Midas-Luna your-email@example.com
